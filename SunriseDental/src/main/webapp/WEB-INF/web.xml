<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">
  <display-name>SunriseDental</display-name>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>



  <session-config>
    <session-timeout>30</session-timeout>
  </session-config>

  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.sunrisedental.filter.AuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.LoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>DashboardServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.DashboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DashboardServlet</servlet-name>
    <url-pattern>/dashboard</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AppointmentServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.AppointmentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/register</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/search</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/edit/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/resend-email/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/history</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/complete/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>AppointmentServlet</servlet-name>
    <url-pattern>/appointments/delete/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PatientServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.PatientServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PatientServlet</servlet-name>
    <url-pattern>/patients/list</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PatientServlet</servlet-name>
    <url-pattern>/patients/add</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PatientServlet</servlet-name>
    <url-pattern>/patients/edit/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PatientServlet</servlet-name>
    <url-pattern>/patients/delete/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>DentistServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.DentistServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>DentistServlet</servlet-name>
    <url-pattern>/dentists/list</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>DentistServlet</servlet-name>
    <url-pattern>/dentists/add</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>DentistServlet</servlet-name>
    <url-pattern>/dentists/edit/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>DentistServlet</servlet-name>
    <url-pattern>/dentists/delete/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>BillServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.BillServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>BillServlet</servlet-name>
    <url-pattern>/billing</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>BillServlet</servlet-name>
    <url-pattern>/billing/search</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>BillServlet</servlet-name>
    <url-pattern>/billing/generate/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>BillServlet</servlet-name>
    <url-pattern>/billing/save/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>BillServlet</servlet-name>
    <url-pattern>/billing/receipt/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>BillServlet</servlet-name>
    <url-pattern>/bills/list</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ReportServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.ReportServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReportServlet</servlet-name>
    <url-pattern>/reports</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>HelpServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.HelpServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>HelpServlet</servlet-name>
    <url-pattern>/help</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ProfileServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.ProfileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ProfileServlet</servlet-name>
    <url-pattern>/settings</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ContactMessagesServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.ContactMessagesServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ContactMessagesServlet</servlet-name>
    <url-pattern>/contact-messages</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ContactMessagesServlet</servlet-name>
    <url-pattern>/contact-messages/delete/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ReceptionistServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.ReceptionistServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ReceptionistServlet</servlet-name>
    <url-pattern>/receptionists</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ReceptionistServlet</servlet-name>
    <url-pattern>/receptionists/list</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ReceptionistServlet</servlet-name>
    <url-pattern>/receptionists/add</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ReceptionistServlet</servlet-name>
    <url-pattern>/receptionists/edit/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>ReceptionistServlet</servlet-name>
    <url-pattern>/receptionists/delete/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>TreatmentServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.TreatmentServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>TreatmentServlet</servlet-name>
    <url-pattern>/treatments</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>TreatmentServlet</servlet-name>
    <url-pattern>/treatments/list</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>TreatmentServlet</servlet-name>
    <url-pattern>/treatments/add</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>TreatmentServlet</servlet-name>
    <url-pattern>/treatments/edit/*</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>TreatmentServlet</servlet-name>
    <url-pattern>/treatments/delete/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PatientPortalServlet</servlet-name>
    <servlet-class>com.sunrisedental.controller.PatientPortalServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PatientPortalServlet</servlet-name>
    <url-pattern>/patient-login</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PatientPortalServlet</servlet-name>
    <url-pattern>/patient-dashboard</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PatientPortalServlet</servlet-name>
    <url-pattern>/patient-logout</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>PatientPortalServlet</servlet-name>
    <url-pattern>/patient-receipt/*</url-pattern>
  </servlet-mapping>
</web-app>
